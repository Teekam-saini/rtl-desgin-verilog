n1:e -> c9:p6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c10:p7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c11:p7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c9:p7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c9:p8:e -> n3:w [color="black", fontcolor="black", label=""];
c10:p8:e -> n4:w [color="black", fontcolor="black", label=""];
c11:p8:e -> n5:w [color="black", fontcolor="black", label=""];
