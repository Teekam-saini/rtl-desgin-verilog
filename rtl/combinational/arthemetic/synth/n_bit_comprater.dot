n3 [ shape=octagon, label="eq", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="gt", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="lt", color="black", fontcolor="black" ];
c9 [ shape=record, label="{{<p6> A|<p7> B}|$3\n$eq|{<p8> Y}}",  ];
