digraph "n_bit_adder" {
label="n_bit_adder";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="a", color="black", fontcolor="black" ];
n3 [ shape=octagon, label="b", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="cin", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="cout", color="black", fontcolor="black" ];
n6 [ shape=diamond, label="result_wire", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="sum", color="black", fontcolor="black" ];
c11 [ shape=record, label="{{<p8> A|<p9> B}|$1\n$add|{<p10> Y}}",  ];
x0 [ shape=record, style=rounded, label="0 -&gt; 4:4 |<s0> 3:0 - 3:0 ", color="black", fontcolor="black" ];
x0:e -> c11:p8:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label=""];
x1 [ shape=record, style=rounded, label="0 -&gt; 4:4 |<s0> 3:0 - 3:0 ", color="black", fontcolor="black" ];
x1:e -> c11:p9:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c12 [ shape=record, label="{{<p8> A|<p9> B}|$2\n$add|{<p10> Y}}",  ];
x2 [ shape=record, style=rounded, label="<s0> 4:4 - 0:0 ", color="black", fontcolor="black" ];
x3 [ shape=record, style=rounded, label="<s0> 3:0 - 3:0 ", color="black", fontcolor="black" ];
c11:p10:e -> c12:p8:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> x0:s0:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> x1:s0:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> c12:p9:w [color="black", fontcolor="black", label=""];
x2:e -> n5:w [color="black", fontcolor="black", label=""];
c12:p10:e -> n6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n6:e -> x2:s0:w [color="black", fontcolor="black", label=""];
n6:e -> x3:s0:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
x3:e -> n7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
}
